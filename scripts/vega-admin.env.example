# ─────────────────────────────────────────────────────────────────────────────
#  Configuración de scripts/vega-admin.sh
#
#  Copia este fichero a scripts/.vega-admin.env (ignorado por git) y rellénalo.
#  Para tener varios entornos a mano, guarda uno por entorno donde quieras y
#  apunta con VEGA_ADMIN_ENV:
#
#    VEGA_ADMIN_ENV=~/.config/vega/test.env scripts/vega-admin.sh prompts
#
#  Las variables de entorno exportadas a mano ganan a este fichero.
# ─────────────────────────────────────────────────────────────────────────────

# Origen público del API, sin barra final y sin el sufijo /api.
VEGA_API_URL=https://vega.ejemplo.es

# Usuario administrador. Usa uno DEDICADO a depuración, no el tuyo: así el
# registro de quién editó cada prompt distingue lo que hace una persona de lo
# que hace una herramienta.
VEGA_ADMIN_EMAIL=depuracion@vega.local
VEGA_ADMIN_PASSWORD=

# Opcional. Dónde deja `pull` los prompts descargados. Por defecto,
# var/prompts/<host>/, que está fuera de git a propósito.
# VEGA_PROMPTS_DIR=~/vega-prompts/prod

# Opcional. Segundos de espera de curl. Una corrección larga pasa del minuto.
# VEGA_TIMEOUT=600
